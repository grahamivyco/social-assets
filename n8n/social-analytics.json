{
  "name": "Social analytics (Instagram + Facebook to Sheet)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 6
            }
          ]
        }
      },
      "id": "an1",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One copy of this workflow per client. Change these four lines and the\n// Sheet URL in the two \"Save\" nodes, then pick the client's Meta credential.\nconst client = 'open-frame';\nconst ig = '17841420040350345';      // Instagram business account id\nconst fb = '1080869611776488';       // Facebook Page id\nconst v = 'v24.0';                   // Graph API version\n\n// This month so far, and all of last month (Meta caps a range at 30 days).\nconst now = DateTime.now().setZone('America/Chicago');\nconst periods = [now.startOf('month'), now.minus({ months: 1 }).startOf('month')].map(start => {\n  let end = start.endOf('month').plus({ seconds: 1 });\n  if (end > now) end = now;\n  const cap = start.plus({ days: 30 });\n  if (end > cap) end = cap;\n  return { month: start.toFormat('yyyy-MM'), since: Math.floor(start.toSeconds()), until: Math.floor(end.toSeconds()) };\n});\nreturn [{ json: { client, ig, fb, v, periods, postsSince: Math.floor(now.minus({ days: 60 }).toSeconds()) } }];"
      },
      "id": "an2",
      "name": "Client settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One request per metric, so a metric Meta retires only blanks one cell.\nconst c = $json;\nconst g = `https://graph.facebook.com/${c.v}`;\nconst igTotals = ['reach', 'views', 'accounts_engaged', 'total_interactions', 'likes', 'comments', 'saves', 'shares', 'profile_links_taps', 'website_clicks', 'profile_views'];\nconst fbTotals = ['page_media_view', 'page_total_media_view_unique', 'page_post_engagements', 'page_views_total', 'page_follows', 'page_daily_follows_unique'];\nconst jobs = [];\nfor (const p of c.periods) {\n  const range = `since=${p.since}&until=${p.until}`;\n  for (const m of igTotals) jobs.push({ month: p.month, platform: 'instagram', metric: m, read: 'total',\n    url: `${g}/${c.ig}/insights?metric=${m}&period=day&metric_type=total_value&${range}` });\n  jobs.push({ month: p.month, platform: 'instagram', metric: 'new_followers', read: 'sum',\n    url: `${g}/${c.ig}/insights?metric=follower_count&period=day&${range}` });\n  for (const m of fbTotals) jobs.push({ month: p.month, platform: 'facebook', metric: m, read: m === 'page_daily_follows_unique' ? 'sum' : 'range',\n    url: `${g}/${c.fb}/insights?metric=${m}&period=${m === 'page_daily_follows_unique' ? 'day' : 'total_over_range'}&${range}` });\n}\n// Follower totals are a snapshot, so they only go on this month's row.\nconst month = c.periods[0].month;\njobs.push({ month, platform: 'instagram', metric: 'followers', read: 'field:followers_count', url: `${g}/${c.ig}?fields=followers_count` });\njobs.push({ month, platform: 'facebook', metric: 'followers', read: 'field:followers_count', url: `${g}/${c.fb}?fields=followers_count` });\nreturn jobs.map(j => ({ json: { ...j, client: c.client } }));"
      },
      "id": "an3",
      "name": "Account metric jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        160
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi"
      },
      "id": "an4",
      "name": "Graph: account metric",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        160
      ],
      "credentials": {
        "facebookGraphApi": {
          "id": "",
          "name": "Open Frame Page"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const jobs = $('Account metric jobs').all();\nconst pulled = DateTime.now().setZone('America/Chicago').toISO();\nreturn $input.all().map((it, i) => {\n  const j = jobs[i].json, r = it.json;\n  let value = '', status = 'ok';\n  try {\n    if (r.error) throw new Error(r.error.message || JSON.stringify(r.error));\n    if (j.read.startsWith('field:')) value = r[j.read.slice(6)];\n    else {\n      const d = (r.data || [])[0];\n      if (!d) throw new Error('no data returned');\n      if (j.read === 'total') { if (!d.total_value) throw new Error('no total_value returned'); value = d.total_value.value; }\n      else if (j.read === 'range') value = (d.values || []).reduce((s, x) => s + (Number(x.value) || 0), 0);\n      else value = (d.values || []).reduce((s, x) => s + (Number(x.value) || 0), 0);\n    }\n  } catch (e) { status = String(e.message).slice(0, 120); }\n  return { json: { key: `${j.month}|${j.platform}|${j.metric}`, client: j.client, month: j.month, platform: j.platform, metric: j.metric, value, status, pulled_at: pulled } };\n});"
      },
