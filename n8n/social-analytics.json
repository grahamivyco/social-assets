    {
      "parameters": {
        "jsCode": "const c = $('Client settings').first().json;\nconst since = c.postsSince * 1000;\nreturn ($json.data || []).filter(p => new Date(p.timestamp).getTime() >= since).map(p => ({ json: {\n  post: p,\n  url: `https://graph.facebook.com/${c.v}/${p.id}/insights?metric=reach,views,saved,shares,total_interactions`,\n} }));"
      },
