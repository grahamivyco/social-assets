          "name": "Open Frame Page"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const jobs = $('IG: post jobs').all();\nconst c = $('Client settings').first().json;\nconst pulled = DateTime.now().setZone('America/Chicago').toISO();\nreturn $input.all().map((it, i) => {\n  const p = jobs[i].json.post, r = it.json;\n  const m = {};\n  for (const d of r.data || []) m[d.name] = d.values && d.values[0] ? d.values[0].value : (d.total_value || {}).value;\n  return { json: {\n    post_id: p.id, client: c.client, platform: 'instagram', published_at: p.timestamp,\n    type: p.media_product_type === 'REELS' ? 'reel' : (p.media_type === 'CAROUSEL_ALBUM' ? 'carousel' : p.media_type.toLowerCase()),\n    permalink: p.permalink, caption: (p.caption || '').split('\\n')[0].slice(0, 90),\n    reach: m.reach ?? '', views: m.views ?? '', likes: p.like_count ?? '', comments: p.comments_count ?? '',\n    saves: m.saved ?? '', shares: m.shares ?? '', clicks: '', interactions: m.total_interactions ?? '',\n    status: r.error ? String(r.error.message).slice(0, 120) : 'ok', pulled_at: pulled,\n  } };\n});"
      },
