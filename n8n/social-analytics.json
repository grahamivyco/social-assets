    {
      "parameters": {
        "jsCode": "// One request per post and metric: Meta rejects the whole call if any metric is retired.\nconst c = $('Client settings').first().json;\nconst metrics = ['post_total_media_view_unique', 'post_media_view', 'post_clicks'];\nreturn ($json.data || []).flatMap(p => metrics.map(metric => ({ json: {\n  post: p, metric,\n  url: `https://graph.facebook.com/${c.v}/${p.id}/insights?metric=${metric}`,\n} })));"
      },
      "id": "an13",
      "name": "FB: post jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        640
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi"
      },
      "id": "an14",
      "name": "FB: post insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        640
      ],
      "credentials": {
        "facebookGraphApi": {
          "id": "",
          "name": "Open Frame Page"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const jobs = $('FB: post jobs').all();\nconst c = $('Client settings').first().json;\nconst pulled = DateTime.now().setZone('America/Chicago').toISO();\nconst byPost = {};\n$input.all().forEach((it, i) => {\n  const { post: p, metric } = jobs[i].json, r = it.json;\n  const row = byPost[p.id] ||= { p, m: {}, errors: [] };\n  const d = (r.data || [])[0];\n  if (r.error) row.errors.push(`${metric}: ${String(r.error.description || r.error.message).slice(0, 60)}`);\n  else if (d && d.values && d.values[0]) row.m[metric] = d.values[0].value;\n});\nreturn Object.values(byPost).map(({ p, m, errors }) => {\n  const reactions = p.reactions ? p.reactions.summary.total_count : '';\n  const comments = p.comments ? p.comments.summary.total_count : '';\n  const shares = p.shares ? p.shares.count : 0;\n  return { json: {\n    post_id: p.id, client: c.client, platform: 'facebook', published_at: p.created_time,\n    type: /video/.test(p.status_type || '') || /\\/reel\\//.test(p.permalink_url || '') ? 'reel' : (p.status_type === 'added_photos' ? 'photo' : (p.status_type || 'post')),\n    permalink: p.permalink_url, caption: (p.message || '').split('\\n')[0].slice(0, 90),\n    reach: m.post_total_media_view_unique ?? '', views: m.post_media_view ?? '', likes: reactions, comments,\n    saves: '', shares, clicks: m.post_clicks ?? '', interactions: [reactions, comments, shares].reduce((s, x) => s + (Number(x) || 0), 0),\n    status: errors.length ? errors.join('; ').slice(0, 160) : 'ok', pulled_at: pulled,\n  } };\n});"
      },
