     "name": "Google Service Account account"
    }
   },
   "executeOnce": true
  },
  {
   "parameters": {
    "jsCode": "return $input.all()\n  .filter(i => i.json.handle && i.json.stage !== 'pass' && !String(i.json.handle).startsWith('TEMPLATE'))\n  .map(i => {\n    const handle = String(i.json.handle).replace('@','').trim();\n    // Built here because a closing brace pair inside an n8n expression ends it early\n    return { json: { handle, fields: 'business_discovery.username(' + handle + '){username,followers_count,media.limit(4){id,caption,permalink,timestamp,like_count,comments_count}}' } };\n  });"
   },
   "id": "o4",
   "name": "Active targets",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    200
   ]
  },
  {
   "parameters": {
    "url": "https://graph.facebook.com/v21.0/17841420040350345",
    "sendQuery": true,
    "specifyQuery": "json",
    "jsonQuery": "={{ JSON.stringify({ fields: $json.fields }) }}",
    "options": {},
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "facebookGraphApi"
   },
   "id": "o5",
   "name": "IG: look up account",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    880,
    200
   ],
   "credentials": {
    "facebookGraphApi": {
     "id": "",
     "name": "Open Frame Page"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "jsCode": "// Posts from the last 3 days that aren't in the Engage tab yet\nconst seen = new Set($('Read Engage').all().map(i => String(i.json.post_id)));\nconst handles = $('Active targets').all().map(i => i.json.handle);\nconst cutoff = Date.now() - 3*24*3600*1000;\nconst out = [];\n$input.all().forEach((item, idx) => {\n  const bd = item.json.business_discovery;\n  if (!bd || !bd.media) return;\n  for (const m of bd.media.data) {\n    if (seen.has(String(m.id)) || new Date(m.timestamp).getTime() < cutoff) continue;\n    out.push({ json: { post_id: String(m.id), found_at: new Date().toISOString(), handle: bd.username,\n      post_url: m.permalink, posted_at: m.timestamp, caption: (m.caption || '').slice(0, 400),\n      likes: m.like_count ?? '', comments: m.comments_count ?? '', draft_comment: '', status: 'new', sent_at: '' } });\n  }\n});\nreturn out;"
   },
   "id": "o6",
   "name": "New posts from targets",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1100,
    120
   ]
  },
  {
   "parameters": {
    "jsCode": "// Mark each target handle ok or show Instagram's error, so problems show up in the Sheet\nconst handles = $('Active targets').all().map(i => i.json.handle);\nreturn $input.all().map((item, idx) => ({ json: {\n  handle: handles[idx],\n  handle_check: item.json.business_discovery\n    ? 'ok (' + item.json.business_discovery.followers_count + ' followers)'\n    : 'error: ' + String(item.json.error?.description || item.json.error?.message || item.json.error || 'no data').slice(0, 200)\n} }));"
   },
   "id": "o7",
   "name": "Handle check",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1100,
    300
   ]
  },
