  {
   "parameters": {
    "url": "={{ 'https://graph.facebook.com/v21.0/' + ($json.data?.[0]?.id || 'missing') + '/recent_media' }}",
    "sendQuery": true,
    "specifyQuery": "json",
    "jsonQuery": "={{ JSON.stringify({ user_id: '17841420040350345', fields: 'id,permalink,timestamp,like_count,comments_count,caption', limit: 10 }) }}",
    "options": {},
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "facebookGraphApi"
   },
   "id": "o12",
   "name": "IG: top posts for hashtag",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    880,
    480
   ],
   "credentials": {
    "facebookGraphApi": {
     "id": "",
     "name": "Open Frame Page"
    }
   },
   "onError": "continueRegularOutput"
  },
  {
   "parameters": {
    "jsCode": "// Top 2 posts per hashtag from the last 24 hours (recent_media), by likes, skipping ones already in Engage\nconst seen = new Set($('Read Engage').all().map(i => String(i.json.post_id)));\nconst tags = $('Read Hashtags').all().map(i => i.json.hashtag);\nconst cutoff = Date.now() - 7*24*3600*1000;\nconst out = [];\n$input.all().forEach((item, idx) => {\n  const posts = (item.json.data || [])\n    .filter(m => !seen.has(String(m.id)) && new Date(m.timestamp).getTime() >= cutoff)\n    .sort((a, b) => (b.like_count || 0) - (a.like_count || 0)).slice(0, 2);\n  for (const m of posts) {\n    seen.add(String(m.id));\n    out.push({ json: { post_id: String(m.id), found_at: new Date().toISOString(), handle: '#' + tags[idx],\n      post_url: m.permalink, posted_at: m.timestamp, caption: (m.caption || '').slice(0, 400),\n      likes: m.like_count ?? '', comments: m.comments_count ?? '', draft_comment: '', status: 'new', sent_at: '' } });\n  }\n});\nreturn out;"
   },
