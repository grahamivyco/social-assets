   "parameters": {
    "jsCode": "// Keep rows that are approved, not yet posted, and due now.\nconst now = Date.now();\nreturn $input.all().filter(i => {\n  const r = i.json;\n  return String(r.status).toLowerCase() === 'approved'\n    && !r.posted_at\n    && r.publish_at && new Date(r.publish_at).getTime() <= now;\n});"
   },
