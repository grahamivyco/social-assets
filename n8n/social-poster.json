  {
   "parameters": {
    "jsCode": "// One item per image. media_url holds 2-10 image URLs separated by new lines, spaces or commas.\nconst out = [];\n$input.all().forEach((it, i) => {\n  const r = it.json;\n  String(r.media_url).split(/[\\s,|]+/).filter(Boolean).slice(0, 10)\n    .forEach(url => out.push({ json: { row_id: r.id, caption: r.caption, url }, pairedItem: { item: i } }));\n});\nreturn out;"
   },
   "name": "IG carousel: split",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    -40
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "https://graph.facebook.com/v21.0/17841420040350345/media",
    "authentication": "predefinedCredentialType",
    "nodeCredentialType": "facebookGraphApi",
    "sendQuery": true,
    "specifyQuery": "json",
    "jsonQuery": "={{ JSON.stringify({ image_url: $json.url, is_carousel_item: true }) }}",
    "options": {}
   },
   "name": "IG carousel: image",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1120,
    -40
   ],
   "credentials": {
    "facebookGraphApi": {
     "id": "",
     "name": "Open Frame Page"
    }
   }
  },
  {
   "parameters": {
    "jsCode": "// Regroup the uploaded image ids by queue row.\nconst src = $('IG carousel: split').all();\nconst groups = {};\n$input.all().forEach((it, i) => {\n  const s = src[i].json;\n  const g = groups[s.row_id] ??= { row_id: s.row_id, caption: s.caption, ids: [], first: i };\n  g.ids.push(it.json.id);\n});\nreturn Object.values(groups).map(g => ({ json: { row_id: g.row_id, caption: g.caption, children: g.ids.join(',') }, pairedItem: { item: g.first } }));"
   },
   "name": "IG carousel: group",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1340,
    -40
   ]
  },
