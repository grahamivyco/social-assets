  {
   "parameters": {
    "jsCode": "// Regroup the uploaded image ids by queue row.\nconst src = $('FB carousel: split').all();\nconst groups = {};\n$input.all().forEach((it, i) => {\n  const s = src[i].json;\n  const g = groups[s.row_id] ??= { row_id: s.row_id, caption: s.caption, ids: [], first: i };\n  g.ids.push(it.json.id);\n});\nreturn Object.values(groups).map(g => ({ json: { row_id: g.row_id, caption: g.caption, attached: JSON.stringify(g.ids.map(id => ({ media_fbid: id }))) }, pairedItem: { item: g.first } }));"
   },
